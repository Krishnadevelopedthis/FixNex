# ============================================================================
#  PR-CAMPUS — environment configuration
#  Copy to .env and fill in.  NEVER commit the real .env file.
# ============================================================================

# ---------------------------------------------------------------- application
ENVIRONMENT=development          # development | production | test
DEBUG=true
APP_NAME=PR-CAMPUS

# ------------------------------------------------------------------- database
# Docker Compose value shown; for a local Postgres use your own credentials.
DATABASE_URL=postgresql+psycopg2://prcampus:prcampus@postgres:5432/prcampus

# ----------------------------------------------------------------------- auth
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------- CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------- background processing
# auto = use Celery when the broker is reachable, else an in-process runner.
TASK_RUNNER=auto
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------ evidence storage
# auto = use MinIO when reachable, else the local filesystem under ./storage
STORAGE_BACKEND=auto
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=prcampus
MINIO_SECRET_KEY=prcampus-secret
MINIO_BUCKET=pr-campus-evidence
MINIO_SECURE=false
MAX_UPLOAD_BYTES=26214400

# --------------------------------------------------------- enrichment services
# Both are optional — the platform falls back to its offline CWE/CVSS catalogue.
# Free NVD key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
SSL_LABS_API_KEY=
OFFLINE_MODE=false

# ------------------------------------------------------------ AI triage (opt-in)
# Entirely optional. Without a key the AI triage feature reports itself as
# unavailable on the System Health page and nothing else changes.
ANTHROPIC_API_KEY=
AI_TRIAGE_ENABLED=true
AI_TRIAGE_MODEL=claude-opus-5
AI_TRIAGE_EFFORT=medium

# --------------------------------------------------------------- scanner tools
# Paths are resolved on PATH by default. Adapters that are not installed are
# reported as UNAVAILABLE on the System Health page and are simply skipped.
NMAP_PATH=nmap
NUCLEI_PATH=nuclei
WHATWEB_PATH=whatweb
ZAP_API_URL=http://zap:8080
ZAP_API_KEY=
SCANNER_TIMEOUT_SECONDS=900

# ------------------------------------------------------------------ SLA (hours)
SLA_HOURS_CRITICAL=24
SLA_HOURS_HIGH=72
SLA_HOURS_MEDIUM=168
SLA_HOURS_LOW=336

# ---------------------------------------------------------- schema migrations
# Apply Alembic migrations as the app starts. Needed on hosts with no release
# phase or shell access (Render's free tier). Leave false where a proper
# pre-deploy hook runs `alembic upgrade head` instead.
RUN_MIGRATIONS_ON_STARTUP=false

# ------------------------------------------------------------------- demo mode
DEMO_MODE=true
# Seed the labelled demo dataset when the database is empty. Skips once any
# assessment exists, so it never overwrites real data.
SEED_ON_STARTUP=false
